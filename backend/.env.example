# ============================================================
# Compare Your Website — backend environment
# ============================================================
# All variables here are OPTIONAL. The app runs without Stripe;
# if STRIPE_SECRET_KEY is missing, the /analyze endpoint still
# works — only the paywall unlock will be disabled.
# ============================================================

# Stripe — test mode keys (start with sk_test_ / pk_test_)
# Get them at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price of the full unlock, in USD cents (2900 = $29.00)
UNLOCK_PRICE_CENTS=2900

# URLs Stripe will redirect to after checkout
FRONTEND_URL=http://localhost:3000

# CORS — comma separated origins allowed to call /analyze
ALLOWED_ORIGINS=http://localhost:3000

# CORS regex — matches every Vercel preview URL by default. Override if you
# host the frontend elsewhere. Set to empty string to disable the regex.
ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*vercel\.app$

# Crawler tuning
MAX_PAGES_PER_SITE=8
PAGE_TIMEOUT_MS=20000
